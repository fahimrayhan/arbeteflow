MONGODB_URI=mongodb://127.0.0.1:27017/jobfinder
ALLOW_DEVELOPMENT_AUTH=true
MODEL_NAME=placeholder-model
MODEL_API_KEY=placeholder-key
TAVILY_API_KEY=

# Encrypts provider API keys stored in MongoDB (AES-256-GCM). Use any long random string.
# If unset, a random key is generated into ./.data/encryption.key — back that file up with your data.
# APP_ENCRYPTION_KEY=
